{
  "schema_version": 1,
  "scope": "Legacy registered OperatorController classes; a public oracle proves only its named pipeline shape, not every option or ordering.",
  "routes": {
    "native_graph": "DAG-ML owns graph, fold, selection or merge semantics; Python binds nirs4all operators.",
    "host_operator": "DAG-ML schedules a Python model or transform controller callback.",
    "host_preparation": "Python reshapes or annotates dataset inputs before native execution.",
    "host_presentation": "Python renders a chart from captured DAG-ML results.",
    "gap": "A public legacy capability is refused or has no matching DAG-ML path.",
    "fallback": "Catch-all router with no independent pipeline capability."
  },
  "controllers": {
